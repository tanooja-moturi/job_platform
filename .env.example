# ─────────────────────────────────────────────
#  Job Board Platform — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development          # Set to "production" when deploying to Render
PORT=5000                     # Render sets this automatically; fallback is 5000

# ── MongoDB Atlas ─────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<AppName>

# ── JWT Auth ──────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=<your-64-byte-hex-secret>
JWT_EXPIRE=30d                # Token expiry (e.g. 7d, 30d, 1y)

# ── CORS ──────────────────────────────────────
# Development:   http://localhost:5173
# Production:    https://your-frontend.vercel.app
# Multiple:      https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Frontend (Vercel) Environment Variables ───
# In the Vercel Dashboard -> Settings -> Environment Variables:
# Key:   VITE_API_URL
# Value: https://<your-render-app>.onrender.com/api
# Note:  Do NOT include a trailing slash!
VITE_API_URL=https://your-render-service.onrender.com/api
