# ─────────────────────────────────────────────
#  Job Board Platform — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development          # Set to "production" when deploying
PORT=5000                     # Express server port

# ── MongoDB Atlas ─────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<AppName>

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=<generate with: node -e "require('crypto').randomBytes(64).toString('hex')">
JWT_EXPIRE=30d                # Token expiry (e.g. 7d, 30d, 1y)

# ── CORS ──────────────────────────────────────
# Development:   http://localhost:5173
# Production:    https://your-deployed-frontend-url.com
FRONTEND_URL=http://localhost:5173

# ── Vite Frontend (MUST start with VITE_) ─────
# Development:   Leave EMPTY — Vite dev proxy handles /api → localhost:5000
# Production:    Set to your deployed backend URL, e.g.:
#                https://your-backend.onrender.com/api
VITE_API_URL=
